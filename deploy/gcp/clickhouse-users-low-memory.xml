<?xml version="1.0"?>
<!-- /etc/clickhouse-server/users.d/low-memory.xml: per-query limits for 1 GB RAM. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>314572800</max_memory_usage>   <!-- 300 MiB per query -->
            <max_threads>2</max_threads>
            <max_insert_threads>1</max_insert_threads>
            <max_block_size>8192</max_block_size>
            <max_bytes_before_external_group_by>104857600</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>104857600</max_bytes_before_external_sort>
            <log_queries>0</log_queries>
        </default>
    </profiles>
</clickhouse>
