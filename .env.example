# Copy to .env and fill in. Never commit .env. Placeholders only.

# --- Email (existing alert emails + ops alerts) ---
MAIL_SENDER=you@example.com
MAIL_APP_PASSWORD=your-gmail-app-password
MAIL_RECIPIENT=you@example.com
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587

# --- WhatsApp Business Platform (Meta Cloud API) ---
WHATSAPP_ENABLED=false               # false = email only; WhatsApp code stays installed but unused
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # use a System User permanent token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_RECIPIENT=+910000000000        # comma-separated E.164 numbers
WHATSAPP_API_VERSION=v25.0
# text     = free-form text (only delivered inside the 24h customer-service window)
# template = always send approved template WHATSAPP_TEMPLATE_NAME with one {{1}} body variable
# auto     = try text, fall back to the template on error 131047 (re-engagement required)
WHATSAPP_SEND_MODE=text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT_SECONDS=20
WHATSAPP_MAX_ATTEMPTS=8
WHATSAPP_RETRY_BACKOFF_SECONDS=60
WHATSAPP_RETRY_BACKOFF_MAX_SECONDS=3600
# false = after a crash mid-send, do not resend (avoid duplicates); item marked FAILED for review
WHATSAPP_RESEND_UNCONFIRMED=false

# --- ClickHouse (defaults match the original scripts) ---
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=300
CLICKHOUSE_MAX_RETRIES=5
CLICKHOUSE_RETRY_DELAY_SECONDS=5

# --- Scheduler ---
ALERT_TIMEZONE=Asia/Kolkata
JOB_MAX_ATTEMPTS=10                  # max attempts per scheduled run (per-job override in config/alert_system.json)
JOB_RETRY_BACKOFF_SECONDS=120        # 2m, 4m, 8m ... capped below (never a tight loop; minimum 30)
JOB_RETRY_BACKOFF_MAX_SECONDS=1800
SCHEDULER_TICK_SECONDS=20
SCHEDULER_MISFIRE_GRACE_SECONDS=300  # later than this = "missed" -> job's catch_up policy applies
SCHEDULER_MAX_CATCHUP_DAYS=7
JOB_STARTUP_RUN_KEY=day              # day = startup jobs at most once per day; boot = every service start
CONNECTIVITY_CHECK_HOSTS=graph.facebook.com:443,query1.finance.yahoo.com:443,1.1.1.1:443
CONNECTIVITY_TIMEOUT_SECONDS=5
CONNECTIVITY_RETRY_SECONDS=60

# --- MTD retention ---
MTD_CLEANUP_ENABLED=true
MTD_CLEANUP_DRY_RUN=false            # true = log what would be deleted, delete nothing
STATE_RETENTION_DAYS=90              # scheduler run history (not market data)

# --- Logging / ops ---
ALERT_LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=14
OPS_ALERT_CHANNELS=email,whatsapp    # where job/cleanup/delivery failures are reported
OPS_DAILY_SUMMARY_CHANNELS=log       # log | email | whatsapp (comma-separated)

# --- Personalised email + recommendations ---
# TRIGGERED_ALERTS_ONLY | WATCHLIST_DAILY_SUMMARY | RECOMMENDATIONS_ONLY | COMBINED_DAILY_REPORT
EMAIL_NOTIFICATION_MODE=COMBINED_DAILY_REPORT
# Recipient(s) of alert and report emails = MAIL_RECIPIENT (comma-separated allowed)
DAILY_REPORT_TIME=16:45              # HH:MM in ALERT_TIMEZONE, weekdays
WATCHLIST_SYMBOLS=                   # extra tracked symbols (e.g. RELIANCE,INFY); rules + active holdings are included automatically
REPORT_INCLUDE_TOP5=true
REPORT_INCLUDE_CAP_TOP5=true
REPORT_INCLUDE_CROSS_ASSET=true      # includes gold/silver ETF status
REPORT_MTD_RANKINGS_EMAIL=true       # the existing 16:30 market-wide MTD rankings email
ALERT_MIN_SEVERITY=WARNING           # WARNING | CRITICAL (CRITICAL = move >= 2x rule threshold)
EMAIL_DEDUP_WINDOW_HOURS=24          # same rule + stock not re-emailed within this window
EMAIL_MAX_ATTEMPTS=8
EMAIL_RETRY_BACKOFF_SECONDS=60
EMAIL_RETRY_BACKOFF_MAX_SECONDS=3600
EMAIL_RESEND_UNCONFIRMED=false
NOTIFICATION_AUDIT_RETENTION_DAYS=90 # delivery audit/dedup rows (kept across month-end cleanup)
PORTFOLIO_CAPITAL=                   # optional, rupees; enables share-count position sizing (1% risk per trade)

# --- Live intraday alerts ---
LIVE_ALERTS_ENABLED=true
LIVE_QUOTE_PROVIDER=yahoo            # free, no account; NSE quotes delayed ~15 min
LIVE_MAX_QUOTE_AGE_MINUTES=30        # older quotes are ignored (never alerted on)

# --- PostgreSQL (multi-user data with row-level security) ---
# Created by deploy/postgres_setup.sh, which generates the passwords and appends them here.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=nse_app
PG_OWNER_PASSWORD=generated-by-postgres_setup.sh
PG_APP_PASSWORD=generated-by-postgres_setup.sh
PG_SERVICE_PASSWORD=generated-by-postgres_setup.sh

# --- Sign-up ---
SIGNUP_MODE=approval            # approval = admin must approve | open = active immediately | closed = invite only
DASHBOARD_PUBLIC_URL=           # e.g. https://34-1-2-3.sslip.io (mentioned in admin approval emails)
